# RAKSHA Phosphor frontend — environment configuration.
# These variables are read by the Python gateway that serves the static build.
# The static Next.js build itself needs no runtime environment file.

RAKSHA_CITIZEN_INTERNAL_URL="http://127.0.0.1:8095"
RAKSHA_INFRA_INTERNAL_URL="http://127.0.0.1:8090"

# Development-only gateway credentials. Override in any non-local deployment.
RAKSHA_FRONTEND_READ_TOKEN="demo-observer-token"
RAKSHA_FRONTEND_SENSOR_TOKEN="demo-sensor-token"
RAKSHA_SENSOR_KEY="raksha-phase678-dev-sensor-key"
